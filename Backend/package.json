{
  "name": "router-agent-system",
  "version": "1.0.0",
  "description": "Router-based multi-agent system — TypeScript + OpenAI + Express",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "portfolio": "ts-node src/portfolio.ts",
    "swap": "ts-node src/swap.ts"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "openai": "^4.47.1",
    "viem": "^2.7.20",
    "x402-axios": "^1.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
